# Copia este archivo a .env (no se sube a git).

# --- Desarrollo local contra el API Gateway (recomendado) ---
# Base VACÍA = mismo origen: el navegador llama a /api/... y el proxy de Vite (vite.config.js)
# reenvía a VITE_PROXY_TARGET. Así no hace falta que el gateway tenga CORS habilitado.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=https://xxxx.execute-api.us-east-1.amazonaws.com

# --- Alternativa: llamar directo al gateway (requiere CORS habilitado en el gateway) ---
# VITE_API_BASE_URL=https://xxxx.execute-api.us-east-1.amazonaws.com

# --- Alternativa: servicios corriendo en local, cada uno en su puerto ---
# La app usa una sola base con paths /api/<servicio>, así que necesitas un gateway/balanceador local
# que las agrupe (p. ej. http://localhost:8080). Si no defines VITE_API_BASE_URL se usa
# VITE_INVENTARIO_URL y, si tampoco existe, http://localhost:8001.
# VITE_INVENTARIO_URL=http://localhost:8001
