#actualizado
# URLs de los 6 microservicios, vía API Gateway en producción
# (todas comparten el mismo dominio del API Gateway, cambia solo el path)
# En LOCAL, cada uno corre en su propio puerto:

VITE_INVENTARIO_URL=http://localhost:8001
VITE_VENTAS_URL=http://localhost:8002
VITE_PROVEEDORES_URL=http://localhost:8003
VITE_PREDICCION_URL=http://localhost:8004
VITE_ALERTAS_URL=http://localhost:8005
VITE_ANALITICA_URL=http://localhost:8006

# En AWS, una vez desplegado el API Gateway, las 6 apuntan al mismo dominio:
# VITE_INVENTARIO_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
# VITE_VENTAS_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
# ...etc (el path /api/<servicio>/... ya lo arma cada componente)
